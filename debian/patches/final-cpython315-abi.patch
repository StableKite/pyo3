Description: Backport final CPython 3.15 structure layouts
Author: Robolightning <irobolightning@gmail.com>
Origin: backport, https://github.com/StableKite/pyo3/tree/codex/python315-abi-028
Bug: https://github.com/PyO3/pyo3/pull/5873
Bug: https://github.com/PyO3/pyo3/pull/5918
Bug: https://github.com/PyO3/pyo3/pull/6014
Forwarded: not-needed
Last-Update: 2026-11-12
 .
 Backport the upstream PyConfig and PyTypeObject layouts without the unrelated
 new slot API. Enable CPython 3.15 after the full ffi-check against final 3.15.2t
 headers and native tests; retain the old PyPy/GraalPy maximum versions.

diff --git a/build.rs b/build.rs
index 2b2acb9e..d1bcbf4c 100644
--- a/build.rs
+++ b/build.rs
@@ -18,7 +18,7 @@ const SUPPORTED_VERSIONS_CPYTHON: SupportedVersions = SupportedVersions {
     min: PythonVersion { major: 3, minor: 7 },
     max: PythonVersion {
         major: 3,
-        minor: 14,
+        minor: 15,
     },
 };
 
@@ -27,7 +27,10 @@ const SUPPORTED_VERSIONS_PYPY: SupportedVersions = SupportedVersions {
         major: 3,
         minor: 11,
     },
-    max: SUPPORTED_VERSIONS_CPYTHON.max,
+    max: PythonVersion {
+        major: 3,
+        minor: 14,
+    },
 };
 
 const SUPPORTED_VERSIONS_GRAALPY: SupportedVersions = SupportedVersions {
@@ -35,7 +38,10 @@ const SUPPORTED_VERSIONS_GRAALPY: SupportedVersions = SupportedVersions {
         major: 3,
         minor: 10,
     },
-    max: SUPPORTED_VERSIONS_CPYTHON.max,
+    max: PythonVersion {
+        major: 3,
+        minor: 14,
+    },
 };
 
 fn ensure_python_version(interpreter_config: &InterpreterConfig) -> Result<()> {
